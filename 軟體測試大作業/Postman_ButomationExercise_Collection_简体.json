      "name": "API 1 - 获取所有商品清单 (GET productsList)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let json; try { json = pm.response.json(); } catch(e) { json = {}; }",
              "pm.test('responseCode 为 200', () => pm.expect(json.responseCode).to.eql(200));",
              "pm.test('响应含 products 数组', () => pm.expect(json.products).to.be.an('array'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/productsList",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "productsList"
          ]
        }
      }
    },
