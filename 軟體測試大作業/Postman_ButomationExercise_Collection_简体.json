            "type": "text/javascript",
            "exec": [
              "// 使用固定测试账号（地址：北京）",
              "pm.environment.set('userName', 'Wjc25S010418');",
              "pm.environment.set('userEmail', 'wjc25S010418@gmail.com');",
              "pm.environment.set('userPassword', 'Wjc25S0418');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let json; try { json = pm.response.json(); } catch(e) { json = {}; }",
              "pm.test('账号创建成功(201)或已存在(400)', () => pm.expect(json.responseCode).to.be.oneOf([201, 400]));",
              "pm.test('消息: User created! 或 已存在', () => pm.expect(String(json.message).toLowerCase()).to.satisfy(m => m.includes('created') || m.includes('exist')));"
